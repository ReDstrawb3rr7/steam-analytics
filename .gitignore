# Data generated by the pipeline, not shipped in the repo (privacy/size)
db/*.db
outputs/*.csv
outputs/*.png

# Model artifacts: joblib files are excluded by default (retrain locally
# to reproduce), EXCEPT the two committed below on purpose. Streamlit
# Community Cloud has no local files at all (no db, no trained model),
# so committing just these lets the deployed dashboard's "Recommendation
# model evaluation" section show real results without retraining there.
outputs/*.joblib
!outputs/recommendation_model.joblib
!outputs/recommendation_model_minus_weighted_vote_score.joblib

# Python
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/

# Environment / secrets (service account keys, .env files, etc.)
# NEVER commit these. Streamlit Cloud's own Secrets manager holds the
# service account credentials instead, see dashboard deployment notes
# in the README.
.env
*.json
!outputs/recommendation_model_eval.json
!outputs/recommendation_model_minus_weighted_vote_score_eval.json

# OS cruft
.DS_Store
Thumbs.db